# Server
PORT=3000
NODE_ENV=development
# Ilova ochiladigan manzil (Google callback shu asosida quriladi)
BASE_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/starosta_uz
# Bulutli DB (Neon, Supabase, Render...) uchun true qiling
PGSSL=false

# Sessiya cookie uchun uzun tasodifiy qator:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx

# ---- Admin panel (/admin) — bitta admin ----
ADMIN_USERNAME=admin
# Parol hashini yarating:  npm run admin:hash -- "kuchli-parolingiz"   va natijani shu yerga qo'ying
ADMIN_PASSWORD_HASH=

# ---- Telegram bot (ixtiyoriy) ----
# @BotFather orqali bot yarating va tokenni kiriting
TELEGRAM_BOT_TOKEN=
# Davomat hisobotlari yuboriladigan kanal: @kanal_nomi yoki -100xxxxxxxxxx (bot kanalga ADMIN qilingan bo'lishi shart)
TELEGRAM_CHANNEL_ID=
# Statistika kunlari uchun vaqt zonasi
APP_TIMEZONE=Asia/Tashkent
