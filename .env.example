# Server
PORT=3000
NODE_ENV=development
# Ilova ochiladigan manzil (Google callback shu asosida quriladi)
BASE_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/starosta_uz
# Bulutli DB (Neon, Supabase, Render...) uchun true qiling
PGSSL=false

# Sessiya cookie uchun uzun tasodifiy qator:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web application)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
